{
  "name": "babygo-server",
  "version": "1.0.0",
  "description": "BabyGo 亲子社交 App 生产级后端服务 (Node.js + Express + PostgreSQL/PostGIS)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "check": "find src test -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node src/scripts/migrate.js",
    "smoke": "node src/scripts/smokeTest.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
